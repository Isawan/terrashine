FROM --platform=$BUILDPLATFORM alpine@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
ARG HOST_BIN_PATH
ARG TARGETARCH
ARG TARGETOS
ARG TARGETPLATFORM
COPY ${HOST_BIN_PATH} /usr/bin/terrashine
ENV RUST_LOG=info
ENV TERRASHINE_HTTP_LISTEN="[::]:9543"
EXPOSE 9543
ENTRYPOINT ["terrashine"]
CMD ["server"]